# Local
VITE_API_BASE_URL=http://localhost:5000/api
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id

# Production (Vercel env) — prefer same-origin so the session cookie works:
# VITE_API_BASE_URL=/api
# (requires the /api rewrite in vercel.json → your backend)
#
# Or full backend URL (needs SameSite=None cookies on the API):
# VITE_API_BASE_URL=https://civildigitalstore-backend.vercel.app/api
