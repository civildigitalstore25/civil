NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/Civil
JWT_SECRET=generate-a-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Civil Digital Store
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-strong-password

# PhonePe: SANDBOX uses Client ID/Secret, PRODUCTION uses Merchant ID + API key
PHONEPE_ENV=SANDBOX
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# Set PHONEPE_ENV=PRODUCTION and fill these from the live dashboard
PHONEPE_MERCHANT_ID=
PHONEPE_API_KEY=
PHONEPE_KEY_INDEX=1

# Email (Brevo) extras
# ADMIN_EMAIL receives new-order alerts (falls back to SUPERADMIN_EMAIL)
ADMIN_EMAIL=
# CONTACT_EMAIL receives contact-form messages (falls back to ADMIN_EMAIL)
CONTACT_EMAIL=
# Email logo = <EMAIL_ASSET_BASE_URL or FRONTEND_URL>/logo.png (frontend/public/logo.png).
# Both optional; EMAIL_LOGO_URL overrides the full logo URL if ever needed.
EMAIL_ASSET_BASE_URL=
EMAIL_LOGO_URL=
